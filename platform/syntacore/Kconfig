config PLATFORM_SYNTACORE
	bool
	select FDT
	select FDT_DOMAIN
	select FDT_PMU
	select FDT_TIMER
	select FDT_IPI
	select FDT_SERIAL
	select FDT_SERIAL_UART8250
	select FDT_IRQCHIP
	select FDT_IRQCHIP_PLIC
	select SBI_ECALL_VENDOR
	default y

if PLATFORM_SYNTACORE

config PLATFORM_SYNTACORE_NR_CPUS
	int "Number of HARTs"
	default 4

config PLATFORM_SYNTACORE_CLOCK_FREQUENCY
	int "Platform clock frequency, Hz"
	default 65000000

config PLATFORM_SYNTACORE_DRAM_SIZE
	hex "Platform DRAM size in bytes, 64 bits"
	default 0xff000000

config PLATFORM_SYNTACORE_DRAM_ORDER
	int "Platform DRAM order (power of 2 in size)"
	default 32

config PLATFORM_SYNTACORE_DMA_ORDER
	int "Platform DMA order (power of 2 in size), DMA size calculates from it"
	default 24

config PLATFORM_SYNTACORE_SCR5
	bool "Syntacore SCR5 cores support"
	default n
	select PLATFORM_SYNTACORE_SWPW

config PLATFORM_SYNTACORE_SCR7
	bool "Syntacore SCR7 cores support"
	default n

config PLATFORM_SYNTACORE_SCR9
	bool "Syntacore SCR9 cores support"
	default n

config PLATFORM_SYNTACORE_SDK_VCU118
	bool "Syntacore VCU118 EVK"
	default n

config PLATFORM_SYNTACORE_SDK_HTG960
	bool "Syntacore HTG960 EVK"
	default n

config PLATFORM_SYNTACORE_SWPW
	bool "Syntacore Software Pagewalker"
	default n

config PLATFORM_SYNTACORE_L1_CACHE
	bool "Enable L1$i & L1$d"
	default y

config PLATFORM_SYNTACORE_L2_CACHE
	bool "Enable L2$"
	default y

config PLATFORM_SYNTACORE_PMP
	bool "Enable PMP instead of MPU"
	default n

config PLATFORM_SYNTACORE_MPU
	bool "Enable MPU instead of PMP"
	depends on !PLATFORM_SYNTACORE_PMP

config PLATFORM_SYNTACORE_BUNDLED_FDT
	bool "Bundle the FDT file into OpenSBI firmware"
	default n

if PLATFORM_SYNTACORE_BUNDLED_FDT

config PLATFORM_SYNTACORE_BUNDLED_FDT_NAME
	string "Bundled FTD file name"
	default ""

endif

config PLATFORM_SYNTACORE_TEXT_START
	hex ".text start addr"
	default 0x0

config PLATFORM_SYNTACORE_JUMP_ADDR
	hex "fw_jump address"
	default 0x400000

config PLATFORM_SYNTACORE_JUMP_FDT_ADDR
	hex "fw_jump fdt address"
	default 0x200000

endif
